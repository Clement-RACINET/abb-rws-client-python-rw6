# Copier ce fichier en .env et renseigner les valeurs réelles
# Ne jamais committer le fichier .env

# Adresse IP du contrôleur ABB (sans slash final)
ROBOT_IP=192.168.125.1

# Credentials RWS (défauts ABB RW6)
RWS_USER=Default User
RWS_PASSWORD=robotics

# Timeout HTTP en secondes (optionnel, défaut : 10)
RWS_TIMEOUT=10

# Module RAPID cible (optionnel, défaut : TRAJCENTER)
# RWS_RAPID_MODULE=TRAJCENTER

# Tâche RAPID cible (optionnel, défaut : T_ROB1)
RWS_RAPID_TASK=T_ROB1
